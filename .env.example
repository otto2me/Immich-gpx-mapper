# Copy this file to .env and set your values. Never commit credentials.
IMMICH_API_URL=http://immich-server:2283
# Optional only when migrating the previous shared API key:
# IMMICH_API_KEY=replace-with-your-immich-api-key
INITIAL_ADMIN_USERNAME=mapper-admin
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
BACKUP_PASSPHRASE_FILE=./secrets/backup-passphrase.txt
IMMICH_DOCKER_NETWORK=immich_default
